# Required for live Jev unless you pass --stub-judge
TYPESAFE_API_KEY=

# live | fixture | auto (try live, sticky-fallback to fixture on transport failure)
POLYMARKET_SOURCE=auto

# Optional Gamma event slug override (default: btc-updown-5m-{floor(now/300)*300})
# BTC_UPDOWN_SLUG=

# Loop interval for npm run watch (~10s reassessment)
TICK_MS=10000

# Confidence gate: ENTER/HOLD/SWITCH only when confidence is strictly greater than this
ACT_THRESHOLD=0.70

# Shares on intended BUY/SELL (dry-run only; never posted)
DRY_RUN_SIZE=10

# Leave unset for dry-run. If 1, LiveBroker throws until wired.
# LIVE_TRADING=

# Append-only PnL ledger
# PNL_PATH=data/pnl.jsonl

# Optional path override for fixture / auto fallback
# FIXTURE_PATH=fixtures/btc-updown-active.json
