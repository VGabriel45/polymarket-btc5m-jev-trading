# Required for live Jev unless you pass --stub-judge
TYPESAFE_API_KEY=

# live | fixture | auto (try live, sticky-fallback to fixture on transport failure)
POLYMARKET_SOURCE=auto

# Optional Gamma event slug override (default: btc-updown-15m-{floor(now/900)*900})
# BTC_UPDOWN_SLUG=

# Loop interval for npm run watch
TICK_MS=15000

# Confidence gate: ACT only when confidence is strictly greater than this
ACT_THRESHOLD=0.70

# Shares logged on intended BUY (dry-run only; never posted)
DRY_RUN_SIZE=10

# Optional path override for fixture / auto fallback
# FIXTURE_PATH=fixtures/btc-updown-active.json
